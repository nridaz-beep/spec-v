{
  "functions": {
    "api/deep-report.js": {
      "includeFiles": "prompts/*.md",
      "maxDuration": 300
    }
  },
  "routes": [
    {
      "src": "/prompts(?:/.*)?",
      "status": 404
    },
    {
      "handle": "filesystem"
    }
  ],
  "git": { "deploymentEnabled": false },
  "buildCommand": "npm run build",
  "outputDirectory": "."
}
